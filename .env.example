# Belentani Judas Experience Environment Configuration
# Copy this file to .env.local and set your values

# Security Settings
BELENTANI_SECRET_KEY=your_secure_secret_key_here_min_32_characters_long
BELENTANI_DEBUG=false

# Database Settings (when using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost/judas_experience

# Session Settings
BELENTANI_SESSION_SECURE=true
BELENTANI_SESSION_HTTPONLY=true
BELENTANI_SESSION_SAMESITE=lax

# CORS Settings (if using external APIs)
CORS_ORIGINS=http://localhost:4320,https://belentani.es

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json